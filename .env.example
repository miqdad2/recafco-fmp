NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
LOG_LEVEL=info
API_BASE_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_STALE_AFTER_MS=60000

# PostgreSQL connection URL
# Use the recafco_fmp_app role (not the postgres superuser) for local development.
# Databases: recafco_fmp_dev (development), recafco_fmp_test (automated tests only).
DATABASE_URL=postgresql://recafco_fmp_app:change_me@localhost:5432/recafco_fmp_dev?schema=public

# Optional: override connection pool defaults
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_POOL_MAX=10

# JWT signing secret — must be at least 32 characters, random, and kept secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_generate_a_random_secret_at_least_32_chars

# Optional: override JWT/session expiry defaults
# JWT_ACCESS_EXPIRES_SECONDS=900
# REFRESH_TOKEN_EXPIRES_DAYS=7

# Optional: override lockout policy defaults
# MAX_FAILED_LOGIN_ATTEMPTS=10
# LOCKOUT_WINDOW_MINUTES=15

# FMP-MAINT-02/06 — optional read-only live dashboard from the RECAFCO MMS.
# FMP API calls MMS server-to-server; the key never reaches the browser.
# MMS_INTEGRATION_KEY must equal MMS's FMP_INTEGRATION_KEY (>= 32 chars) — secret.
# Leave it unset to show "MMS integration not configured".
# See docs/runbooks/mms-integration.md.
# MMS_BASE_URL        = INTERNAL address the FMP API uses to call MMS (never shown to users).
# MMS_PUBLIC_BASE_URL = PUBLIC address users open; every link on the dashboard uses it.
# MMS_BASE_URL=http://192.168.1.17:81
# MMS_PUBLIC_BASE_URL=https://maintenance.recafco.online
# MMS_LIVE_DASHBOARD_ENDPOINT=/api/integrations/fmp/maintenance-dashboard/live
# MMS_INTEGRATION_KEY=change_me_same_value_as_mms_fmp_integration_key
# MMS_QUERY_TIMEOUT_MS=8000
# MMS_LIVE_REFRESH_SECONDS=30

# FMP-OPS-01 — optional read-only synchronization from the external RECAFCO Operations system.
# Read by the WORKER only (never the API or the browser). OFF unless OPERATIONS_SYNC_ENABLED=true AND
# a dedicated integration account is set. Never use an administrator's login. See docs/operations-integration.md.
# The worker also needs DATABASE_URL (same value as the API).
# OPERATIONS_SYNC_ENABLED=false
# OPERATIONS_SOURCE_BASE_URL=https://management.recafco.online
# OPERATIONS_SOURCE_USERNAME=
# OPERATIONS_SOURCE_PASSWORD=
# OPERATIONS_SYNC_POLL_INTERVAL_SECONDS=60
# OPERATIONS_SYNC_REQUEST_TIMEOUT_MS=15000
# OPERATIONS_SYNC_MAX_RESPONSE_BYTES=2000000
# OPERATIONS_SYNC_CONCURRENCY=2
# OPERATIONS_SYNC_MAX_BACKOFF_SECONDS=900

# FMP-OPS-02 — DEVELOPMENT ONLY. Enables the isolated Operations monitoring demonstration (fixture figures and the
# /dev/operations-demo controls). The API REFUSES TO START in production when this is set. Set it in BOTH the repo
# root .env (API) and apps/web/.env.local (web). Never set it on the company server.
# OPERATIONS_DEMO_ENABLED=true

# FMP-OPS-03 — optional, worker only. Authentication mode, project discovery and request spreading.
# OPERATIONS_SOURCE_AUTH_MODE=password        # 'password' (default, dedicated account) or 'demo' (the source's demo sign-in;
#                                              depends on the source keeping its demo access available). No fallback between modes.
# OPERATIONS_SOURCE_DEMO_FACTORY=precast      # demo payload (defaults are exactly the supplied values)
# OPERATIONS_SOURCE_DEMO_ROLE=manager
# OPERATIONS_SOURCE_DEMO_WORKSPACE=existing
# OPERATIONS_DISCOVERY_ENABLED=false          # read GET /api/projects and link unique job-order + factory matches
# OPERATIONS_DISCOVERY_INTERVAL_SECONDS=900   # minimum 300
# OPERATIONS_EXCLUDED_PROJECT_IDS=project_b29b21f0f3fb   # comma list; test projects flagged is_training=false. Empty clears it.
# OPERATIONS_PROJECT_LIST_MAX_BYTES=5000000
# OPERATIONS_SYNC_STAGGER_MS=300
