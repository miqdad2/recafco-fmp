// ---------------------------------------------------------------------------
// Contracts Management Foundation
// Unit 12 — added 2026-07-01
//
// Stored status lifecycle: DRAFT → ACTIVE → TERMINATED | CLOSED
// Derived display states (computed server-side, no background job):
//   EXPIRING = stored ACTIVE + renewalNoticeDate ≤ today ≤ endDate
//   EXPIRED  = stored ACTIVE + endDate < today
//
// Reference numbers are CONTRACT-YYYY-NNNNNN generated atomically via
//   ContractSequence upsert inside the creation transaction (UTC year).
//   Sequence CHECK: last_seq BETWEEN 0 AND 999999.
//
// Optimistic concurrency: every mutating transition increments version.
//   updateMany(WHERE id AND status AND version) + count check → CONTRACT_VERSION_CONFLICT.
//
// onDelete: Restrict on ownerUser, createdByUser, and all child history tables.
//   SetNull on nullable lifecycle user FKs.
//
// actorUserId in ContractActivity has no FK — mirrors IncidentActivity.
//   actorName is denormalized to preserve history when users are deactivated.
// ---------------------------------------------------------------------------

enum ContractStatus {
  DRAFT
  ACTIVE
  TERMINATED
  CLOSED
  // CM-69A — safe void/cancel flow for a wrongly created draft/test contract
  // (from DRAFT) or a mistakenly activated one (from ACTIVE). Distinct from
  // TERMINATED, which keeps its own real meaning (a genuinely executed
  // contract ended early, still closeout-eligible) — a cancelled contract is
  // never closeout-eligible and is never hard-deleted; related records are
  // always kept for audit.
  CANCELLED

  @@map("contract_status")
}

enum ContractBoqMixDesignType {
  GRAY
  WHITE
  NOT_APPLICABLE

  @@map("contract_boq_mix_design_type")
}

enum ContractPaymentStatus {
  DRAFT
  SUBMITTED
  CERTIFIED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED

  @@map("contract_payment_status")
}

// CM-55 — manager-facing schedule/progress status for the Contract List's
// Status column. Deliberately a SEPARATE field from Contract.status
// (the real lifecycle: DRAFT/ACTIVE/TERMINATED/CLOSED) — this is never
// written by activate/terminate/close, and setting it never bypasses the
// closeout approval flow. Nullable: existing/new contracts start unset;
// the API computes a neutral display default (IN_PROGRESS, or COMPLETED
// once the contract's real lifecycle status is CLOSED) until a manager
// explicitly picks a value via PATCH /contracts/:id/schedule-status — see
// computeEffectiveScheduleStatus() in contracts.service.ts.
enum ContractScheduleStatus {
  IN_PROGRESS
  ON_TRACK
  DELAYED
  COMPLETED
  AHEAD_OF_SCHEDULE

  @@map("contract_schedule_status")
}

model ContractSequence {
  year    Int @id
  lastSeq Int @default(0) @map("last_seq")

  @@map("contract_sequences")
}

model Contract {
  id                       String                  @id @default(uuid()) @db.Uuid
  referenceNumber          String                  @unique @map("reference_number") @db.VarChar(25)
  title                    String                  @db.VarChar(300)
  description              String?                 @db.Text
  status                   ContractStatus          @default(DRAFT)
  version                  Int                     @default(1)
  counterpartyName         String                  @map("counterparty_name") @db.VarChar(300)
  counterpartyContact      String?                 @map("counterparty_contact") @db.VarChar(500)
  jobOrder                 String?                 @map("job_order") @db.VarChar(100)
  contractDate             DateTime?               @map("contract_date") @db.Date
  quotationNumber          String?                 @map("quotation_number") @db.VarChar(100)
  projectNumber            String?                 @map("project_number") @db.VarChar(100)
  scopeOfWork              Json?                   @map("scope_of_work") @db.JsonB
  paymentTerms             Json?                   @map("payment_terms") @db.JsonB
  contractValue            Decimal?                @map("contract_value") @db.Decimal(18, 3)
  currency                 String?                 @db.VarChar(3)
  startDate                DateTime?               @map("start_date") @db.Date
  endDate                  DateTime?               @map("end_date") @db.Date
  renewalNoticeDate        DateTime?               @map("renewal_notice_date") @db.Date
  clientContactName        String?                 @map("client_contact_name") @db.VarChar(150)
  clientContactPhone       String?                 @map("client_contact_phone") @db.VarChar(50)
  forecastCompletionDate   DateTime?               @map("forecast_completion_date") @db.Date
  originalContractValue    Decimal?                @map("original_contract_value") @db.Decimal(18, 3)
  originalCurrency         String?                 @map("original_currency") @db.VarChar(3)
  projectSiteLocation      String?                 @map("project_site_location") @db.VarChar(255)
  scopeDescription         String?                 @map("scope_description") @db.Text
  scopeExclusions          String?                 @map("scope_exclusions") @db.Text
  deliverables             String?                 @db.Text
  milestones               String?                 @db.Text
  scheduleSummary          String?                 @map("schedule_summary") @db.Text
  quantitiesSpecifications String?                 @map("quantities_specifications") @db.Text
  craneRequired            String?                 @map("crane_required") @db.VarChar(30)
  craneProvidedBy          String?                 @map("crane_provided_by") @db.VarChar(30)
  estimatedCraneCapacity   String?                 @map("estimated_crane_capacity") @db.VarChar(100)
  ownerUserId              String                  @map("owner_user_id") @db.Uuid
  departmentId             String?                 @map("department_id") @db.Uuid
  plantId                  String?                 @map("plant_id") @db.Uuid
  locationId               String?                 @map("location_id") @db.Uuid
  notes                    String?                 @db.Text
  createdByUserId          String                  @map("created_by_user_id") @db.Uuid
  activatedAt              DateTime?               @map("activated_at") @db.Timestamptz(3)
  activatedByUserId        String?                 @map("activated_by_user_id") @db.Uuid
  terminatedAt             DateTime?               @map("terminated_at") @db.Timestamptz(3)
  terminatedByUserId       String?                 @map("terminated_by_user_id") @db.Uuid
  terminationReason        String?                 @map("termination_reason") @db.VarChar(1000)
  closedAt                 DateTime?               @map("closed_at") @db.Timestamptz(3)
  closedByUserId           String?                 @map("closed_by_user_id") @db.Uuid
  // CM-69A — safe cancel/void flow. Never set alongside terminatedAt/closedAt.
  cancelledAt              DateTime?               @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId        String?                 @map("cancelled_by_user_id") @db.Uuid
  cancellationReason       String?                 @map("cancellation_reason") @db.VarChar(1000)
  // CM-55 — see ContractScheduleStatus above. Additive/nullable; never set
  // by activate/terminate/close, never read by closeout eligibility checks.
  scheduleStatus           ContractScheduleStatus? @map("schedule_status")
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerUser        User        @relation("ContractOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdByUser    User        @relation("ContractCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activatedByUser  User?       @relation("ContractActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  terminatedByUser User?       @relation("ContractTerminatedBy", fields: [terminatedByUserId], references: [id], onDelete: SetNull)
  closedByUser     User?       @relation("ContractClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser  User?       @relation("ContractCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  plant            Plant?      @relation(fields: [plantId], references: [id], onDelete: SetNull)
  location         Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)

  comments                         ContractComment[]
  activities                       ContractActivity[]
  boqItems                         ContractBoqItem[]
  payments                         ContractPayment[]
  workflowTasks                    ContractWorkflowTask[]
  issues                           ContractIssue[]
  claims                           ContractClaim[]
  variations                       ContractVariation[]
  risks                            ContractRisk[]
  documentObligations              ContractDocumentObligation[]
  closeoutRequests                 ContractCloseoutRequest[]
  scheduleItems                    ContractScheduleItem[]
  erectionMethodStatement          ContractErectionMethodStatement?
  // Not a real one-to-one from Contract's own side (contractId here isn't
  // unique — only methodStatementId is, on the model itself) — practically
  // at most one row, but declared as a list since Prisma requires either a
  // unique FK or list cardinality for a back-relation.
  erectionMethodStatementApprovals ContractErectionMethodStatementApproval[]
  erectionSchedule                 ContractErectionSchedule?
  erectionDeliveryStart            ContractErectionDeliveryStart?
  erectionStart                    ContractErectionStart?
  erectionChecklist                ContractErectionChecklist?
  erectionWorkflowAssignment       ContractErectionWorkflowAssignment?

  @@index([status, createdAt(sort: Desc)])
  @@index([ownerUserId, status])
  @@index([createdByUserId])
  @@index([departmentId])
  @@index([plantId])
  @@index([endDate, status])
  @@index([renewalNoticeDate, status])
  @@map("contracts")
}

// BOQ / contract item line details captured during Contract Register.
// Progress/Invoice % and Amount Remaining are deliberately NOT stored here —
// both are always derived from invoiceQty/totalPrice (see
// boqProgressPercent()/boqAmountRemaining() in the web app's
// contract-boq-helpers.ts), never trusted/stored values.
model ContractBoqItem {
  id                     String                    @id @default(uuid()) @db.Uuid
  contractId             String                    @map("contract_id") @db.Uuid
  sortOrder              Int                       @map("sort_order")
  itemCode               String?                   @map("item_code") @db.VarChar(100)
  category               String?                   @db.VarChar(100)
  description            String                    @db.VarChar(500)
  drawingReference       String?                   @map("drawing_reference") @db.VarChar(150)
  specificationReference String?                   @map("specification_reference") @db.VarChar(150)
  originalEstimatedQty   Decimal?                  @map("original_estimated_qty") @db.Decimal(14, 3)
  revisedQty             Decimal?                  @map("revised_qty") @db.Decimal(14, 3)
  unitOfMeasure          String?                   @map("unit_of_measure") @db.VarChar(50)
  mixDesignType          ContractBoqMixDesignType? @map("mix_design_type")
  concreteGrade          String?                   @map("concrete_grade") @db.VarChar(50)
  unitPrice              Decimal?                  @map("unit_price") @db.Decimal(18, 3)
  totalPrice             Decimal?                  @map("total_price") @db.Decimal(18, 3)
  // CM-56D — "Drawing Qty": quantity confirmed during drawing/calculation
  // stages, distinct from originalEstimatedQty (the original contract BOQ
  // qty/area) and revisedQty (which IS used as a Total-Price override via
  // boqRowQty()). Drawing Qty is deliberately never read by any BOQ
  // formula — purely informational/technical quantity confirmation.
  drawingQty             Decimal?                  @map("drawing_qty") @db.Decimal(14, 3)
  // CM-56 — real, editable "Invoice Qty" (New Contract Register / BOQ table).
  // Additive/nullable; Progress % and Amount Remaining stay derived, never
  // stored (see model comment above).
  invoiceQty             Decimal?                  @map("invoice_qty") @db.Decimal(14, 3)
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract         Contract                         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  productionStatus ContractBoqItemProductionStatus?

  @@unique([contractId, itemCode])
  @@index([contractId, sortOrder])
  @@map("contract_boq_items")
}

// CM-59 — Contract Production Status. Production quantities are manually
// updated inside Contract Management (no separate Production Module
// integration exists yet); one optional row per BOQ item, created lazily on
// first update rather than seeded for every item. onDelete: Cascade because
// Edit Contract's BOQ save path deletes and recreates ALL of a contract's
// ContractBoqItem rows whenever the BOQ is replaced (see
// contracts.service.ts update()) — Restrict would break that existing save
// flow the moment any item had production tracked. This means editing a
// contract's BOQ resets production tracking for that contract; documented
// here and in the CM-59 progress-tracker entry as a known, honest tradeoff
// rather than hidden. producedQty/deliveredQty are the only stored values —
// stockNotDelivered/remainingToCast/progressPercent are always derived, never
// stored (same convention as ContractBoqItem's own invoiceQty/Progress %).
model ContractBoqItemProductionStatus {
  id                String                      @id @default(uuid()) @db.Uuid
  contractBoqItemId String                      @unique @map("contract_boq_item_id") @db.Uuid
  producedQty       Decimal                     @default(0) @map("produced_qty") @db.Decimal(14, 3)
  deliveredQty      Decimal                     @default(0) @map("delivered_qty") @db.Decimal(14, 3)
  status            ContractBoqProductionStatus @default(NOT_STARTED)
  remarks           String?                     @db.Text
  updatedByUserId   String?                     @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  contractBoqItem ContractBoqItem @relation(fields: [contractBoqItemId], references: [id], onDelete: Cascade)
  updatedByUser   User?           @relation("ContractBoqProductionStatusUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("contract_boq_item_production_status")
}

enum ContractBoqProductionStatus {
  NOT_STARTED
  IN_PRODUCTION
  PARTIALLY_DELIVERED
  COMPLETED
  DELAYED

  @@map("contract_boq_production_status")
}

model ContractComment {
