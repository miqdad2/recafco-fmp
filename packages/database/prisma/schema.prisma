// Module-level claim register (CM-31) — tracks claims across ALL contracts,
// distinct from any single contract's own workspace view. claimNo is optional
// but unique per contract when provided (same pattern as ContractPayment.paymentNo
// and ContractIssue.issueNo). outstandingValue is never stored — always
// computed in the service as submittedValue - approvedValue. No hard delete:
// closing/settling goes through status = CLOSED/SETTLED via update.
model ContractClaim {
  id                String              @id @default(uuid()) @db.Uuid
  contractId        String              @map("contract_id") @db.Uuid
  claimNo           String?             @map("claim_no") @db.VarChar(50)
  claimTitle        String              @map("claim_title") @db.VarChar(300)
  claimType         ContractClaimType   @default(OTHER) @map("claim_type")
  eventDate         DateTime?           @map("event_date") @db.Date
  claimDate         DateTime?           @map("claim_date") @db.Date
  status            ContractClaimStatus @default(DRAFT)
  submittedValue    Decimal?            @map("submitted_value") @db.Decimal(18, 3)
  approvedValue     Decimal?            @map("approved_value") @db.Decimal(18, 3)
  eotClaimedDays    Int?                @map("eot_claimed_days")
  eotApprovedDays   Int?                @map("eot_approved_days")
  responsibleUserId String?             @map("responsible_user_id") @db.Uuid
  nextAction        String?             @map("next_action") @db.VarChar(500)
  dueDate           DateTime?           @map("due_date") @db.Date
  closedDate        DateTime?           @map("closed_date") @db.Date
  remarks           String?             @db.Text
  createdByUserId   String              @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?             @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  responsibleUser User?    @relation("ContractClaimResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdByUser   User     @relation("ContractClaimCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser   User?    @relation("ContractClaimUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([contractId, claimNo])
  @@index([contractId, createdAt(sort: Desc)])
  @@index([status])
  @@index([dueDate, status])
  @@map("contract_claims")
}

enum ContractVariationStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED

  @@map("contract_variation_status")
}

// CM-60 — Variations / Change Orders. "Variation" is the contract/QS term
// used throughout this model/table (per the task's explicit naming
// decision — "Change Orders" appears only in the page/tab title, not here).
// amount is a signed Decimal — a deductive variation is stored as a real
// negative number (see approved-design screenshot's "-12,000.000" row), never
// clamped to zero. affectsContractValue defaults to true (most variations do
// affect value) but can be set false for a variation that only affects
// completion date or scope, with no value impact. supportingDocumentName/Url
// are plain optional text/link fields, NOT a file upload — this unit
// deliberately does not add a new attachment/storage pipeline (see CM-60
// progress-tracker entry); a manager can name/link an already-existing
// document (e.g. from Documents & Obligations) but cannot upload one here.
// Current Contract Value for the Variations page is computed on read as
// Contract.originalContractValue + sum(APPROVED, affectsContractValue=true) —
// Contract.contractValue itself is never mutated by this model (that stays
// BOQ-derived, per contracts.service.ts, untouched by this unit).
model ContractVariation {
  id                     String                  @id @default(uuid()) @db.Uuid
  contractId             String                  @map("contract_id") @db.Uuid
  variationNo            String?                 @map("variation_no") @db.VarChar(50)
  description            String                  @db.VarChar(500)
  amount                 Decimal?                @db.Decimal(18, 3)
  currency               String                  @default("KWD") @db.VarChar(3)
  affectsContractValue   Boolean                 @default(true) @map("affects_contract_value")
  status                 ContractVariationStatus @default(DRAFT)
  submittedDate          DateTime?               @map("submitted_date") @db.Date
  approvedDate           DateTime?               @map("approved_date") @db.Date
  supportingDocumentName String?                 @map("supporting_document_name") @db.VarChar(300)
  supportingDocumentUrl  String?                 @map("supporting_document_url") @db.VarChar(1000)
  remarks                String?                 @db.Text
  createdByUserId        String                  @map("created_by_user_id") @db.Uuid
  updatedByUserId        String?                 @map("updated_by_user_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract      Contract                      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdByUser User                          @relation("ContractVariationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser User?                         @relation("ContractVariationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  attachments   ContractVariationAttachment[]

  @@unique([contractId, variationNo])
  @@index([contractId, createdAt(sort: Desc)])
  @@index([status])
  @@map("contract_variations")
}

// CM-60C — real uploaded supporting documents for a variation (site
// instructions, drawing markups, client emails, BOQ/calculation sheets,
// quotations, engineer approvals). Local-disk storage, structure mirrors
// ContractWorkflowTaskAttachment/ContractCloseoutAttachment exactly
// (fileName/fileSize naming kept consistent with those two sibling tables
// rather than this unit's own "stored_file_name"/"size_bytes" wording — same
// meaning, matching the established convention). onDelete: Cascade — no
// delete endpoint exists for a variation today, but if one is ever added its
// attachments should never become orphaned rows pointing at nothing.
// supportingDocumentName/supportingDocumentUrl on ContractVariation itself
// are untouched — real uploads are additive, not a replacement.
model ContractVariationAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  variationId      String   @map("variation_id") @db.Uuid
  fileName         String   @map("file_name") @db.VarChar(255)
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(150)
  fileSize         Int      @map("file_size")
  storagePath      String   @map("storage_path") @db.VarChar(500)
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  variation      ContractVariation @relation(fields: [variationId], references: [id], onDelete: Cascade)
  uploadedByUser User              @relation("ContractVariationAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([variationId, createdAt(sort: Desc)])
  @@map("contract_variation_attachments")
}

enum ContractRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("contract_risk_level")
}

enum ContractRiskResponse {
  MITIGATE
