// CM-63 — Documents & Obligations: required contract documents, certificates,
// submissions, guarantees, and approvals with their obligation deadlines
// (Performance Bond, Insurance, APG, Tax Clearance, Method Statement, Shop
// Drawings Approval, Environmental Approval, Safety Plan, etc.). `status` is
// always a plain manual selection — never silently overwritten by date math.
// Expiring Soon / Expired-Overdue KPI counts are DERIVED at read time from
// `status` + `submissionOrExpiryDate` (see contract-document-obligations.service.ts
// computeDocumentObligationSummary()) without ever mutating the stored
// `status` column, so a manager's own status choice is never second-guessed
// by the system.
model ContractDocumentObligation {
  id                     String                             @id @default(uuid()) @db.Uuid
  contractId             String                             @map("contract_id") @db.Uuid
  itemNo                 String?                            @map("item_no") @db.VarChar(50)
  title                  String                             @db.VarChar(300)
  category               ContractDocumentObligationCategory @default(OTHER)
  responsibleParty       String?                            @map("responsible_party") @db.VarChar(150)
  requiredDate           DateTime?                          @map("required_date") @db.Date
  /// CM-70E — legacy combined field from before Submission Date and Expiry
  /// Date were split into their own columns. Never written to by new
  /// records; kept, unmigrated, so no existing data is lost or guessed at.
  submissionOrExpiryDate DateTime?                          @map("submission_or_expiry_date") @db.Date
  /// CM-70E — date the document was submitted/received. Additive, nullable.
  submissionDate         DateTime?                          @map("submission_date") @db.Date
  /// CM-70E — date the document expires, if applicable. Additive, nullable.
  expiryDate             DateTime?                          @map("expiry_date") @db.Date
  status                 ContractDocumentObligationStatus   @default(PENDING)
  remarks                String?                            @db.Text
  createdByUserId        String                             @map("created_by_user_id") @db.Uuid
  updatedByUserId        String?                            @map("updated_by_user_id") @db.Uuid
  createdAt              DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract      Contract                               @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdByUser User                                   @relation("ContractDocumentObligationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser User?                                  @relation("ContractDocumentObligationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  attachments   ContractDocumentObligationAttachment[]

  @@unique([contractId, itemNo])
  @@index([contractId, createdAt(sort: Desc)])
  @@index([status])
  @@map("contract_document_obligations")
