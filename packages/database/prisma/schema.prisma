  closeoutRequest ContractCloseoutRequest @relation(fields: [closeoutRequestId], references: [id], onDelete: Restrict)
  uploadedByUser  User                    @relation("ContractCloseoutAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

