// CM-62 — Contract Risk Assessment. Deliberately NOT an ISO risk-management
// system: riskEvaluation ("Risk Evaluation" — initial level before response)
// and residualRisk ("expected level after the response action") are both
// plain manual dropdowns, never auto-calculated or scored — no numeric risk
// score is stored anywhere on this model. riskResponse is one of exactly 4
// values (Mitigate/Accept/Avoid/Transfer); manager examples like
// "Subcontracting"/"Insurance" are NOT response types — they belong in the
// free-text riskResponseDescription only (e.g. "Transfer" + "Cover through
// insurance and subcontractor responsibility clause."). responsibleUserId
// (not a free-text "responsiblePerson" string) follows the same FK+picker
// pattern already established for ContractClaim.responsibleUserId — a
// deliberate deviation from this unit's own literal field-name wording, for
// consistency with the rest of this codebase.
model ContractRisk {
  id                      String               @id @default(uuid()) @db.Uuid
  contractId              String               @map("contract_id") @db.Uuid
  riskNo                  String?              @map("risk_no") @db.VarChar(50)
  description             String               @db.VarChar(500)
  riskEvaluation          ContractRiskLevel    @default(MEDIUM) @map("risk_evaluation")
  riskResponse            ContractRiskResponse @default(MITIGATE) @map("risk_response")
  riskResponseDescription String?              @map("risk_response_description") @db.Text
  residualRisk            ContractRiskLevel?   @map("residual_risk")
  status                  ContractRiskStatus   @default(OPEN)
  responsibleUserId       String?              @map("responsible_user_id") @db.Uuid
  actionDueDate           DateTime?            @map("action_due_date") @db.Date
  remarks                 String?              @db.Text
  createdByUserId         String               @map("created_by_user_id") @db.Uuid
  updatedByUserId         String?              @map("updated_by_user_id") @db.Uuid
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  responsibleUser User?    @relation("ContractRiskResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdByUser   User     @relation("ContractRiskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser   User?    @relation("ContractRiskUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([contractId, riskNo])
  @@index([contractId, createdAt(sort: Desc)])
  @@index([status])
  @@map("contract_risks")
}

// CM-68A — one row per fixed real business stage (see
// ContractScheduleStageKey below) for one contract's PLANNED schedule only.
// "Actual" values are never stored here — they're derived live from real
// workflow/payment/production/closeout records (see
// contract-schedule-plan.service.ts). responsibleTeam is a free-text field
// (not the ContractWorkflowTeam enum) since 4 of the 8 real stages
// (Contract Sign, Advance Payment, Estimation Sheet, Final Closeout) don't
// map onto any real workflow team — forcing that enum here would be
// dishonest for those stages.
model ContractScheduleItem {
