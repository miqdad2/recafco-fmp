  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([contractId, createdAt(sort: Asc)])
  @@map("contract_activities")
}

// Module-level payments register (CM-28) — tracks payments across ALL contracts,
// distinct from any single contract's own workspace view. paymentNo is optional
// but unique per contract when provided (same pattern as ContractBoqItem.itemCode).
// No hard delete: cancellation goes through status = CANCELLED via update.
model ContractPayment {
  id              String                @id @default(uuid()) @db.Uuid
  contractId      String                @map("contract_id") @db.Uuid
  paymentNo       String?               @map("payment_no") @db.VarChar(50)
  invoiceNumber   String?               @map("invoice_number") @db.VarChar(100)
  invoiceDate     DateTime?             @map("invoice_date") @db.Date
  paymentTerm     String?               @map("payment_term") @db.VarChar(100)
  submittedAmount Decimal?              @map("submitted_amount") @db.Decimal(18, 3)
  certifiedAmount Decimal?              @map("certified_amount") @db.Decimal(18, 3)
  paidAmount      Decimal?              @map("paid_amount") @db.Decimal(18, 3)
  dueDate         DateTime?             @map("due_date") @db.Date
  paidDate        DateTime?             @map("paid_date") @db.Date
  status          ContractPaymentStatus @default(DRAFT)
  remarks         String?               @db.Text
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  updatedByUserId String?               @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdByUser User     @relation("ContractPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser User?    @relation("ContractPaymentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([contractId, paymentNo])
  @@index([contractId, createdAt(sort: Desc)])
  @@index([status])
  @@index([dueDate, status])
  @@map("contract_payments")
