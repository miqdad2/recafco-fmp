// Module-level workflow register (CM-29) — one row per team task per contract.
// taskKey is a stable per-template identifier (e.g. "technical_drawing_received")
// so lazy generation from scopeOfWork is idempotent: generation only inserts
// taskKeys that don't already exist for the contract, never overwrites.
model ContractWorkflowTask {
  id                String                       @id @default(uuid()) @db.Uuid
  contractId        String                       @map("contract_id") @db.Uuid
  team              ContractWorkflowTeam
  taskKey           String                       @map("task_key") @db.VarChar(100)
  taskName          String                       @map("task_name") @db.VarChar(200)
  sortOrder         Int                          @map("sort_order")
  status            ContractWorkflowTaskStatus   @default(NOT_STARTED)
  priority          ContractWorkflowTaskPriority @default(MEDIUM)
  delayReason       String?                      @map("delay_reason") @db.Text
  responsibleUserId String?                      @map("responsible_user_id") @db.Uuid
  startDate         DateTime?                    @map("start_date") @db.Date
  dueDate           DateTime?                    @map("due_date") @db.Date
  completedDate     DateTime?                    @map("completed_date") @db.Date
  remarks           String?                      @db.Text
  // CM-46B — optional Contract Staff task-intake fields (Receipt Details /
  // Drawing-Task Information / Follow-up notes), never core workflow state.
  // See contract-workflow.service.ts's sanitizeWorkflowTaskFormData().
  formData          Json?                        @map("form_data") @db.JsonB
  lastActivityAt    DateTime                     @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdByUserId   String                       @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?                      @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract        Contract                         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  responsibleUser User?                            @relation("ContractWorkflowTaskResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdByUser   User                             @relation("ContractWorkflowTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser   User?                            @relation("ContractWorkflowTaskUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  attachments     ContractWorkflowTaskAttachment[]
  comments        ContractWorkflowTaskComment[]

  @@unique([contractId, taskKey])
  @@index([contractId, sortOrder])
  @@index([status])
  @@index([dueDate, status])
  @@map("contract_workflow_tasks")
}

// CM-32 — file attachments for a workflow task. Binary data is never stored
// in the database, only metadata + a storage-relative path resolved by
// WorkflowAttachmentStorageService. No hard delete in this unit (see
// contract-workflow.service.ts header comment for the deferred-delete note).
model ContractWorkflowTaskAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  taskId           String   @map("task_id") @db.Uuid
  fileName         String   @map("file_name") @db.VarChar(255)
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(150)
  fileSize         Int      @map("file_size")
  storagePath      String   @map("storage_path") @db.VarChar(500)
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task           ContractWorkflowTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  uploadedByUser User                 @relation("ContractWorkflowTaskAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt(sort: Desc)])
  @@map("contract_workflow_task_attachments")
}

// CM-32 — free-text progress comments/activity log for a workflow task.
model ContractWorkflowTaskComment {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  comment         String   @db.Text
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task          ContractWorkflowTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  createdByUser User                 @relation("ContractWorkflowTaskCommentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt(sort: Desc)])
  @@map("contract_workflow_task_comments")
}

