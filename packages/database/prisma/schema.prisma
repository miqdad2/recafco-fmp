// Module-level issue register (CM-30) — tracks issues across ALL contracts,
// distinct from any single contract's own workspace view. issueNo is optional
// but unique per contract when provided (same pattern as ContractPayment.paymentNo).
// category is a plain string (not an enum) for flexibility, validated at the
// API layer against a controlled list rather than a DB constraint.
// No hard delete: closing goes through status = CLOSED via update.
model ContractIssue {
  id                String                @id @default(uuid()) @db.Uuid
  contractId        String                @map("contract_id") @db.Uuid
  issueNo           String?               @map("issue_no") @db.VarChar(50)
  title             String                @db.VarChar(300)
  description       String?               @db.Text
  category          String?               @db.VarChar(50)
  priority          ContractIssuePriority @default(MEDIUM)
  status            ContractIssueStatus   @default(OPEN)
  responsibleUserId String?               @map("responsible_user_id") @db.Uuid
  raisedDate        DateTime?             @map("raised_date") @db.Date
  dueDate           DateTime?             @map("due_date") @db.Date
  closedDate        DateTime?             @map("closed_date") @db.Date
  resolution        String?               @db.Text
  remarks           String?               @db.Text
  createdByUserId   String                @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?               @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  responsibleUser User?    @relation("ContractIssueResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  createdByUser   User     @relation("ContractIssueCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser   User?    @relation("ContractIssueUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([contractId, issueNo])
  @@index([contractId, createdAt(sort: Desc)])
  @@index([status])
  @@index([dueDate, status])
  @@map("contract_issues")
}

enum ContractClaimType {
  VARIATION
  EXTENSION_OF_TIME
  DELAY
  PAYMENT
  DAMAGE
  SCOPE_CHANGE
  OTHER

  @@map("contract_claim_type")
